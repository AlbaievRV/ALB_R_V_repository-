# Initial dictionary
my_dict = {"name": "Alice", "age": 25, "city": "Kyiv"}
print(f"Initial dictionary: {my_dict}")

# 1. keys() - returns a view of all keys
print(f"keys(): {my_dict.keys()}")

# 2. values() - returns a view of all values
print(f"values(): {my_dict.values()}")

# 3. items() - returns a view of all key-value pairs
print(f"items(): {my_dict.items()}")

# 4. update() - updates the dictionary with elements from another dictionary
my_dict.update({"age": 26, "profession": "Engineer"})
print(f"After update(): {my_dict}")

# 5. del statement - removes an element by key
del my_dict["city"]
print(f"After del my_dict['city']: {my_dict}")

# 6. clear() - removes all items from the dictionary
my_dict.clear()
print(f"After clear(): {my_dict}")